{
  "entities": {
    "MenuCategory": {
      "title": "MenuCategory",
      "description": "A menu category in Corano Restaurant.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "order": { "type": "number" }
      },
      "required": ["name", "order"]
    },
    "MenuItem": {
      "title": "MenuItem",
      "description": "A menu item with its R2 or external image URL stored in img.",
      "type": "object",
      "properties": {
        "category": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 200 },
        "price": { "type": "string", "maxLength": 60 },
        "desc": { "type": "string", "maxLength": 2000 },
        "img": { "type": "string", "maxLength": 1000 },
        "available": { "type": "boolean" },
        "addons": { "type": "array" },
        "order": { "type": "number" },
        "isNew": { "type": "boolean" }
      },
      "required": ["category", "title", "price"]
    },
    "Review": {
      "title": "Review",
      "description": "A customer review for Corano Restaurant.",
      "type": "object",
      "properties": {
        "author": { "type": "string", "maxLength": 120 },
        "text": { "type": "string", "maxLength": 2000 },
        "rating": { "type": "number" },
        "date": { "type": "string", "maxLength": 80 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] }
      },
      "required": ["author", "text", "rating", "date"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "An authorized admin Gmail account granted access by a root or existing admin.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "addedBy": { "type": "string", "maxLength": 254 },
        "createdAt": { "type": "string", "maxLength": 80 }
      },
      "required": ["email"]
    }
  },
  "firestore": {
    "/menuCategories/{categoryId}": {
      "schema": { "$ref": "#/entities/MenuCategory" },
      "description": "Stores menu categories ordered by index."
    },
    "/menuItems/{itemId}": {
      "schema": { "$ref": "#/entities/MenuItem" },
      "description": "Stores menu items and their image URLs (img)."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Stores customer reviews."
    },
    "/admins/{email}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Stores dynamically authorized admin Gmail accounts."
    }
  }
}
